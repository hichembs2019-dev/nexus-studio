# Copy to .env and fill in real values. Never commit .env itself.
# Any value left blank runs against the mock for that piece instead of
# failing - see README.md.

# --- ComfyUI (the real GPU pod's HTTP proxy URL) ---
# e.g. https://<pod-id>-8188.proxy.runpod.net
COMFYUI_BASE_URL=

# --- Jupyter on the same pod (used only for remote ffmpeg stitching of
# multi-scene episodes; a single-scene episode works without it) ---
# e.g. https://<pod-id>-8888.proxy.runpod.net
JUPYTER_BASE_URL=
JUPYTER_PASSWORD=

# --- Groq (primary - Writer/Director reasoning) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Gemini (Groq's fallback - a genuinely separate account/quota, see
# docs/SOURCES.md "Groq org-wide quota") ---
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# --- YouTube (Publishing Agent - live-verified against the real "Nexora"
# channel; see docs/SOURCES.md "Nexora channel setup" for the full real
# setup walkthrough, including every real error hit along the way) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Telegram (the bot interface - /new, /edit, /cancel, and the
# Approve/Publish buttons; see README.md "Using the bot") ---
TELEGRAM_BOT_TOKEN=

# --- Azure AI Speech (Text-to-Speech voiceover - narrates each scene in
# the Screenplay's own language/dialect, e.g. ar-TN-HediNeural for
# Tunisian Arabic; see docs/SOURCES.md "Azure TTS voiceover" for the real
# setup walkthrough and verified REST contract) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Output ---
OUTPUT_DIR=./output
