# Copy to .env and fill in real values. Never commit .env itself.
# Any value left blank runs against the mock for that piece instead of
# failing - see README.md.

# --- Groq (primary - the real dialogue/casting reasoning calls) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Gemini (Groq's fallback - a genuinely separate account/quota, see
# docs/SOURCES.md "Groq org-wide quota") ---
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# --- YouTube (Publishing Agent - live-verified against the real "Nexora"
# channel; see docs/SOURCES.md "Nexora channel setup" for the full real
# setup walkthrough, including every real error hit along the way) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Telegram (the bot interface - /new, /edit, /cancel, and the
# Approve/Publish buttons; see README.md "Using the bot") ---
TELEGRAM_BOT_TOKEN=

# --- Azure AI Speech (real TTS for each spoken dialogue line, lip-synced
# by fal.ai's speech-to-video; see docs/SOURCES.md "Azure TTS voiceover"
# for the real setup walkthrough and verified REST contract) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- fal.ai (the real speech-to-video + reference-photo generation -
# see docs/SOURCES.md "fal.ai real pricing/output check". KNOWN REAL
# BILLING ISSUE: see docs/SOURCES.md "fal.ai billed every real
# speech-to-video call at the 720p rate..." - still used for reference
# photos regardless of which video provider is chosen below) ---
FAL_KEY=

# --- Replicate (second real speech-to-video provider, wan-video/wan-2.2-s2v
# - see docs/SOURCES.md "A second real video provider: Replicate...").
# VIDEO_PROVIDER picks "fal" or "replicate" explicitly; left blank,
# Replicate is used when REPLICATE_API_TOKEN is set, else fal.ai. ---
REPLICATE_API_TOKEN=
VIDEO_PROVIDER=

# --- Output ---
OUTPUT_DIR=./output
