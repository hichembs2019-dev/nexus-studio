# Copy to .env and fill in real values. Never commit .env itself.
# Any value left blank runs against the mock for that piece instead of
# failing - see README.md.

# --- ComfyUI (the real GPU pod's HTTP proxy URL) ---
# e.g. https://<pod-id>-8188.proxy.runpod.net
COMFYUI_BASE_URL=

# --- Jupyter on the same pod (used only for remote ffmpeg stitching of
# multi-scene episodes; a single-scene episode works without it) ---
# e.g. https://<pod-id>-8888.proxy.runpod.net
JUPYTER_BASE_URL=
JUPYTER_PASSWORD=

# --- Groq (scene planning - the Director Agent's one reasoning call) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Output ---
OUTPUT_DIR=./output
