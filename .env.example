# Copy to .env and fill in real values. Never commit .env itself.
# Any value left blank runs against the mock for that piece instead of
# failing - see README.md.

# --- Groq (primary - the real dialogue/casting reasoning calls) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Gemini (Groq's fallback - a genuinely separate account/quota, see
# docs/SOURCES.md "Groq org-wide quota") ---
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# --- YouTube (Publishing Agent - live-verified against the real "Nexora"
# channel; see docs/SOURCES.md "Nexora channel setup" for the full real
# setup walkthrough, including every real error hit along the way) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Telegram (the bot interface - /new, /edit, /cancel, and the
# Approve/Publish buttons; see README.md "Using the bot") ---
TELEGRAM_BOT_TOKEN=

# --- Azure AI Speech (real TTS for each spoken dialogue line, lip-synced
# by Replicate's speech-to-video; see docs/SOURCES.md "Azure TTS voiceover"
# for the real setup walkthrough and verified REST contract) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Replicate (the real image provider - black-forest-labs/flux-dev for
# reference photos, always needed even in self-hosted video mode below.
# Also the real video provider, wan-video/wan-2.2-s2v, whenever the
# self-hosted engine below is not configured. fal.ai was removed
# entirely, 2026-10-21 - see docs/SOURCES.md "fal.ai billed every real
# speech-to-video call at the 720p rate..." and "fal.ai deleted from the
# codebase" for why. ---
REPLICATE_API_TOKEN=

# --- Self-hosted Wan 2.2 S2V (preferred over Replicate for VIDEO when
# configured - portraits still use Replicate above; see src/app.py's own
# "Owner's instruction, 2026-10-22" comment and docs/SOURCES.md "Self-
# hosted Wan 2.2 S2V: a real cinematic clip, proven end to end"). Needs a
# real, already-provisioned Runpod pod - there is no "create one on
# demand" path, since the real model weights only exist on one specific
# pod's network volume. ---
RUNPOD_API_KEY=
RUNPOD_S2V_POD_ID=
# Real, live-read rate for this project's own pod (Runpod MCP list-pods,
# 2026-10-22: one NVIDIA A40, $0.59/hr) - update if the pod is ever
# recreated on different hardware.
RUNPOD_S2V_HOURLY_RATE_USD=0.59
# Real, explicit owner switch (2026-10-23) - leave unset/false until you
# have actually read docs/SOURCES.md "MultiTalk two-speaker generation
# proven real, end to end" and decided to turn real two-speaker pairing
# on. Set to true only on the real droplet's own .env, never synced
# automatically from a GitHub secret - see deploy.yml's own comment on
# this exact line for why.
MULTITALK_ENABLED=false

# --- Output ---
OUTPUT_DIR=./output
